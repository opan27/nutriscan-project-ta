# =============================================
# NutriScan - Docker Production Environment (TEMPLATE)
# Salin jadi .env.docker lalu isi nilai yang ditandai GANTI:
#   cp .env.docker.example .env.docker
# =============================================

# Server
PORT=3000
NODE_ENV=production

# Database MySQL (nama host = nama service di docker-compose)
DB_HOST=mysql
DB_PORT=3306
DB_USER=nutriscan
DB_PASSWORD=GANTI_password_database_yang_kuat
DB_NAME=nutriscan_db

# JWT - buat secret acak: openssl rand -hex 32
JWT_SECRET=GANTI_dengan_string_acak_panjang
JWT_EXPIRES_IN=7d

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# YOLO Service URL (nama host = nama service di docker-compose)
YOLO_SERVICE_URL=http://yolo-service:5001
