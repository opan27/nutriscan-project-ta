# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS yolo-runner

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY yolo_requirements.txt .
# Torch versi CPU (VPS tanpa GPU): image lebih kecil & hemat RAM dibanding versi CUDA
RUN pip install --default-timeout=2000 --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install --default-timeout=2000 --no-cache-dir -r yolo_requirements.txt

# Copy YOLO model and server
COPY yolo/ ./yolo/
COPY yolo_server.py .

# Expose Flask port
EXPOSE 5001

# Production server: 1 worker (model di-load sekali), beberapa thread untuk request bersamaan
CMD ["gunicorn", "--workers", "1", "--threads", "4", "--timeout", "120", "--bind", "0.0.0.0:5001", "yolo_server:app"]
